<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DockNest.ico</ApplicationIcon>
    <Version>0.1.6</Version>
    <Description>分组收藏文件、文件夹和链接的桌面工具。</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing;System.Windows.Forms" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <Compile Remove="Tests\**\*.cs" />
    <Page Remove="Tests\**\*.xaml" />
    <None Remove="Tests\**" />
    <Compile Remove="artifacts\**\*.cs" />
    <Page Remove="artifacts\**\*.xaml" />
    <Resource Include="Assets\DockNest.ico" />
    <None Update="README.md;LICENSE;THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
